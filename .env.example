# EliteDevTicket - Exemplo de Variáveis de Ambiente
# Mantenha este arquivo sem credenciais ou segredos reais.

# --- Perfil de Execução ---
# local: padrão para desenvolvimento/compose local; usa seeds de demo e chave JWT efêmera se ausente
# demo: usa seeds de demo, exige segredos e credenciais de banco explícitas
# prod: sem seeds de demo, exige segredos e credenciais de banco explícitas
SPRING_PROFILES_ACTIVE=local

# --- Banco de Dados PostgreSQL ---
# No perfil 'local' com o docker-compose ou postgres local padrão, valores default são aplicados automaticamente.
# Nos perfis 'demo' e 'prod', todas as três variáveis são obrigatórias (fail-fast na inicialização).
DATABASE_URL=jdbc:postgresql://localhost:5432/elitedevticket
DATABASE_USERNAME=elitedevticket
DATABASE_PASSWORD=

# --- Autenticação & Segurança ---
# Obrigatório em 'demo' e 'prod' (Base64 com pelo menos 32 bytes). No perfil 'local', se omitido, uma chave efêmera é gerada.
# AUTH_JWT_SECRET=your-base64-encoded-32-byte-secret-here
# AUTH_JWT_TTL=PT8H
# AUTH_COOKIES_SECURE=false

# --- Integração Externa Ticketmaster (Opcional) ---
# Se ausente, buscas externas retornam fallback gracioso de erro sem derrubar a aplicação.
# TICKETMASTER_API_KEY=your-ticketmaster-api-key-here

# --- Frontend / Vite ---
# Alvo do proxy reverso de API no servidor Vite de desenvolvimento
VITE_API_PROXY_TARGET=http://localhost:8080
